  "keyFeatures": [
    "Dual authentication for premium (official) and non-premium (cracked) Minecraft accounts",
    "Automatic login for premium players via Mojang session verification",
    "Secure password-based registration and login for non-premium players",
    "Session persistence to reduce repeated logins",
    "Configurable database backends (SQLite, MySQL)",
    "Customizable in-game messages and prompts",
    "Fine-grained permissions for commands and admin actions",
    "Protection against unauthorized access before authentication"
  ],
  "publicApiSurface": [
    "/register <password> <confirmPassword>",
    "/login <password>",
    "/logout",
    "/changepassword <oldPassword> <newPassword>",
    "/rlogin reload",
    "/rlogin unregister <player>",
    "/rlogin forcelogin <player>",
    "permission: rlogin.admin",
    "permission: rlogin.bypass"
  ]
